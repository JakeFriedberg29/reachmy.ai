{
  "name": "reachmy-ai",
  "version": "0.1.0",
  "private": true,
  "description": "reachmy.ai Agent Network",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "node scripts/prettier-changed.mjs --write",
    "format:check": "node scripts/prettier-changed.mjs",
    "test": "tsx --env-file=.env --test \"tests/**/*.test.ts\"",
    "test:unit": "tsx --test tests/host-routing.test.ts tests/db-safety.test.ts tests/dcr-policy.test.ts",
    "smoke:phase0": "tsx --env-file=.env scripts/phase0-smoke.ts",
    "smoke:phase1": "tsx --env-file=.env scripts/phase1-smoke.ts",
    "smoke:portal": "tsx --env-file=.env scripts/portal-smoke.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.6",
    "@hono/node-server": "^1.19.0",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.4",
    "jose": "^6.0.13",
    "oidc-provider": "^9.11.3",
    "postgres": "^3.4.9",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "@types/oidc-provider": "^9.11.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0"
  },
  "packageManager": "pnpm@10.15.0"
}
