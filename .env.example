# Copy to .env for local use. Never commit real secrets.
# Local issuer must stay localhost so OAuth callbacks do not hit Railway.
#
# Local Portal preview (no DNS required):
#   pnpm dev
#   curl -i -H "Host: app.reachmy.ai" http://127.0.0.1:3000/
# Portal pages: /, /sign-in, /account  |  API: /v1/portal/overview
#
# DATABASE: use the Neon *development* branch (ep-steep-dream-ayihhbrl).
# Production endpoint ep-tiny-violet-ayrr8l02 is blocked for local runs unless
# ALLOW_PRODUCTION_DB=1 (emergency only — never set by default).

PUBLIC_URL=http://localhost:3000
PORTAL_URL=https://app.reachmy.ai
PORTAL_HOST=app.reachmy.ai
PORT=3000
COOKIE_KEYS=change-me-to-a-long-random-string
DATABASE_URL=postgresql://USER:PASSWORD@ep-steep-dream-ayihhbrl.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
